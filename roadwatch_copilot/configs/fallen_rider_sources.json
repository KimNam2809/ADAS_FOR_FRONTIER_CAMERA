{
  "schema_version": 1,
  "target_taxonomy": {
    "specialist_detection_classes": ["fallen_person", "fallen_two_wheeler"],
    "temporal_event": "fallen_rider",
    "temporal_states": [
      "rider_normal",
      "rider_unstable",
      "fall_transition",
      "fallen_persistent",
      "recovered_or_left_scene"
    ],
    "hard_negative_labels": [
      "person_sitting_roadside",
      "person_bending",
      "person_repairing_vehicle",
      "person_lying_off_road",
      "parked_two_wheeler",
      "occluded_rider",
      "person_near_two_wheeler",
      "road_debris"
    ]
  },
  "sources": [
    {
      "slug": "PKU-IMAGELAB/D2-City",
      "license": "requires_official_release_review",
      "status": "hard_negatives_and_candidate_mining_only",
      "viewpoint": "forward_dashcam",
      "annotation_type": "12-class bbox and tracking; no verified fallen-rider label",
      "reason": "Official paper verifies road-user detection/tracking, not pose/fall labels."
    },
    {
      "slug": "AnAn-A3D",
      "license": "unverified",
      "status": "quarantined",
      "viewpoint": "forward_dashcam",
      "annotation_type": "accident/anomaly clips; fallen-rider bbox claim unverified",
      "reason": "Do not use until the official download, license and annotation schema are audited."
    },
    {
      "slug": "CADP",
      "license": "requires_release_terms_review",
      "status": "temporal_pretraining_only",
      "viewpoint": "fixed_cctv",
      "annotation_type": "accident spatio-temporal annotations",
      "reason": "Camera-domain mismatch prevents target evaluation use."
    },
    {
      "slug": "CARLA",
      "license": "MIT",
      "status": "synthetic_supplement_only",
      "viewpoint": "configurable_forward_camera",
      "annotation_type": "synthetic bbox/segmentation/track/actor state",
      "reason": "Useful for coverage, but never replaces held-out real dashcam evaluation."
    },
    {
      "slug": "simuletic/cctv-incident-dataset-fall-and-lying-down-detection",
      "license": "CC BY-NC-SA 4.0",
      "status": "pretraining_only",
      "reason": "Overhead/fixed CCTV domain and mostly positive laying samples; not representative of a moving dashcam.",
      "quality_gate_evidence": {
        "kaggle_kernel": "lekimnam/roadwatch-fallen-rider-quality-gate",
        "kernel_version": 1,
        "images_train": 111,
        "images_val": 111,
        "train_val_sha256_duplicates": 111,
        "instances": {"laying": 222, "standing": 20},
        "negative_images": 0,
        "passed": false
      }
    },
    {
      "slug": "nardengerges/accident-no-accident-detection",
      "license": "unknown",
      "status": "quarantined",
      "reason": "Scene-level accident labels do not localize a fallen rider, and the published license is unknown."
    }
  ],
  "required_target_dataset": {
    "name": "roadwatch-fallen-rider-dashcam",
    "viewpoint": "forward-facing dashcam",
    "classes": ["fallen_person", "fallen_two_wheeler"],
    "minimum_instances_per_class": 250,
    "negative_images_to_positive_images_ratio_min": 2.0,
    "night_or_adverse_fraction_min": 0.2,
    "validation_real_positive_fraction_min": 0.3,
    "test_set_policy": "100% real forward-facing dashcam; zero synthetic samples; frozen before training",
    "provenance_required_fields": ["slug", "license", "provenance_url", "permission_type"],
    "scenario_group_fields": [
      "source_video_id",
      "scenario_family",
      "carla_town",
      "scenario_seed",
      "capture_session",
      "camera_configuration"
    ],
    "split_rule": "group by original video before frame extraction"
  },
  "locked_regression_media": [
    "test_video1.mp4",
    "test_video2.mp4",
    "test_video10.mp4",
    "test_video11.mp4",
    "video_test.mp4"
  ]
}
