{
  "schema_version": 1,
  "plan_id": "RW-OBJECT-V2",
  "status": "blocked_on_target_domain_annotations",
  "base_candidates": ["yolo11n.pt", "roadwatch_objects_v1_1.pt"],
  "taxonomy": ["person", "rider", "bicycle", "motorcycle", "car", "bus", "truck"],
  "sources": {
    "approved_existing": ["BDD100K", "DAWN"],
    "quarantined": ["BARD"],
    "target_domain": [
      "dashcam_vietnam.mp4",
      "dashcam_vietnam_night.mp4",
      "dashcam_vietnam_rain+night.mp4",
      "dashcam_vietnam_traffic_multi.mp4",
      "test_video1.mp4",
      "test_video5.mp4",
      "video_test.mp4"
    ]
  },
  "annotation_gate": {
    "minimum_target_images": 2500,
    "minimum_negative_images": 1000,
    "minimum_night_images": 400,
    "minimum_rain_images": 300,
    "minimum_instances_per_class": {
      "person": 1000,
      "rider": 600,
      "bicycle": 600,
      "motorcycle": 1000,
      "car": 2000,
      "bus": 500,
      "truck": 800
    },
    "required_hard_cases": [
      "small_far_vru",
      "partial_occlusion",
      "night_glare",
      "rain_blur",
      "car_vs_truck_confusion",
      "dense_motorcycles",
      "oncoming_traffic",
      "parked_roadside_negative"
    ],
    "split_unit": "source_video_plus_contiguous_scene",
    "duplicate_leakage_allowed": false,
    "human_visual_review_sample": 200
  },
  "training": {
    "primary_model": "yolo11n",
    "teacher_experiment": "yolo11s",
    "image_sizes": [640, 768],
    "epochs": 80,
    "patience": 15,
    "batch": "auto_on_remote_gpu",
    "mixed_precision": true,
    "class_balancing": "train_only_weighted_sampler_or_copy_paste_vru",
    "validation_and_test_augmentation": false
  },
  "promotion_gate": {
    "heldout_map50_95_min": 0.32,
    "heldout_recall_min": 0.60,
    "vru_recall_min": 0.55,
    "car_truck_confusion_rate_max": 0.03,
    "timestamp_event_recall_not_lower_than_baseline": true,
    "false_alerts_per_minute_max": 3.0,
    "object_latency_p95_vs_baseline_max_ratio": 1.25,
    "manual_fp_fn_review_count": 100
  }
}
