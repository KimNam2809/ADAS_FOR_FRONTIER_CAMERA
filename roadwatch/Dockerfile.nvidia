FROM node:22-alpine AS frontend-build
WORKDIR /build
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM pytorch/pytorch:2.4.0-cuda12.4-cudnn9-runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/backend \
    ROADWATCH_DEVICE=0 \
    ROADWATCH_RUNTIME=cuda \
    ROADWATCH_DISABLE_AUDIO=1
WORKDIR /app
COPY requirements.txt /tmp/requirements.txt
RUN grep -vE 'onnxruntime|ultralytics|piper-tts' /tmp/requirements.txt > /tmp/base.txt \
    && pip install --no-cache-dir -r /tmp/base.txt \
    && pip install --no-cache-dir onnxruntime-gpu pathvalidate ultralytics piper-tts --no-deps
COPY backend ./backend
COPY configs ./configs
COPY --from=frontend-build /build/dist ./frontend/dist
RUN mkdir -p /app/models /app/media /app/data /app/voices
EXPOSE 8000
CMD ["uvicorn", "roadwatch.api:app", "--host", "0.0.0.0", "--port", "8000"]
