{
  "schema_version": 1,
  "plan_id": "RW-LANE-V2",
  "status": "phase1_v1_running_training_still_blocked",
  "remote_job": {
    "kernel": "lekimnam/roadwatch-lane-v2-target-quality-gate",
    "version": 2,
    "submitted_at": "2026-08-24",
    "url": "https://www.kaggle.com/code/lekimnam/roadwatch-lane-v2-target-quality-gate",
    "purpose": "600-frame target-domain candidate-label pilot with FFmpeg decode fallback; no training"
  },
  "architecture": "UFLDv2 ResNet-18 with YOLOP drivable-area fusion",
  "baseline": "YOLOP lane mask",
  "target_domain_videos": [
    "dashcam_vietnam.mp4",
    "dashcam_vietnam_night.mp4",
    "dashcam_vietnam_rain+night.mp4",
    "dashcam_vietnam_traffic_multi.mp4",
    "test_video5.mp4"
  ],
  "annotation_schema": {
    "format": "ordered lane polylines",
    "required_fields": [
      "lane_instance_id",
      "polyline_points",
      "ego_left_boundary",
      "ego_right_boundary",
      "marking_type",
      "visibility",
      "road_direction"
    ],
    "marking_types": ["solid", "dashed", "double", "curb", "unknown"],
    "road_directions": ["same_direction", "opposing", "unknown"]
  },
  "annotation_gate": {
    "minimum_verified_frames": 3000,
    "minimum_night_frames": 500,
    "minimum_rain_frames": 400,
    "minimum_multi_lane_frames": 1000,
    "minimum_faded_or_missing_marking_frames": 400,
    "split_unit": "source_video_plus_contiguous_scene",
    "human_double_review_frames": 300,
    "review_disagreement_max": 0.05
  },
  "training": {
    "reference_input": [1600, 320],
    "edge_candidate_inputs": [[1280, 320], [800, 320]],
    "epochs": 100,
    "mixed_precision": true,
    "early_stopping_patience": 15,
    "public_pretraining": ["CULane"],
    "target_domain_finetune": true,
    "validation_and_test_augmentation": false
  },
  "promotion_gate": {
    "lane_count_accuracy_min": 0.95,
    "ego_boundary_f1_min": 0.90,
    "night_rain_ego_boundary_recall_min": 0.85,
    "temporal_offset_jitter_p95_max_normalized": 0.03,
    "ldw_false_alerts_per_minute_max": 1.0,
    "local_amd_full_pipeline_fps_min": 12.0,
    "local_amd_end_to_end_p95_ms_max": 150.0,
    "jetson_int8_pipeline_fps_target": 30.0,
    "jetson_gate_requires_real_hardware": true
  }
}
